# .cogpublic — Public release gate for myrgic/charts
# Defines what must never cross the boundary outward.
#
# ENFORCED BY: the org-level Public Release Gate workflow
#   (myrgic/.github/.github/workflows/public-release-gate.yml), run in CI on
#   every PR. Locally, from a checkout of myrgic/.github:
#     python3 scripts/cogpublic-guard.py --root /path/to/charts
#
# WHY THIS REPO HAS ONE: charts are Helm templates deploying CogOS nodes —
# the class of file where real cluster hostnames, internal IPs, registry
# credentials, and operator paths tend to land as "temporary" values.yaml
# defaults and then ship. Verified clean at adoption (2026-08-31): the only
# registry references are the public ghcr.io/myrgic images and the only
# endpoint is http://localhost:11434 (a documented local-Ollama default).

version: 1

content_guards:
  - pattern: "/Users/slowbro"
    description: "Hardcoded operator home directory (macOS)"
  - pattern: "/home/slowbro"
    description: "Hardcoded operator home directory (Linux)"
  - pattern: "-Users-slowbro-"
    description: "Claude project path encoding"
  - pattern: "192404964621025291"
    description: "Personal Discord user snowflake"
  - pattern: 'sk-[a-zA-Z0-9]{20,}'
    description: "OpenAI API key pattern"
  - pattern: 'ghp_[a-zA-Z0-9]{20,}'
    description: "GitHub personal access token"
  - pattern: 'xoxb-[a-zA-Z0-9]+'
    description: "Slack bot token"
  - pattern: '@gmail\.com|@yahoo\.com|@hotmail\.com'
    description: "Personal email address (git author emails exempt)"
  - pattern: 'dockerconfigjson|imagePullSecrets:\s*\n\s*-\s*name:\s*"?[a-z0-9-]*cred'
    description: "Inlined registry credential material in chart values"

# DELIBERATELY NOT GUARDED, verified 2026-08-31 — recorded so the next person
# does not "helpfully" add them:
#
#   Bare IP / hostname regexes (10.x, 192.168.x, *.local) — drafted and
#     removed: the repo currently contains ZERO such literals, and a generic
#     IP regex fires on chart version strings and resource examples in docs.
#     If a real cluster address ever needs guarding, add the specific literal.
#
#   "localhost" / port numbers — cogos-kernel/values.yaml documents the
#     Ollama default endpoint http://localhost:11434. That is public API
#     surface for anyone deploying the chart, not a leak.
#
#   ghcr.io — the myrgic images are the public artifacts these charts exist
#     to deploy; guarding the registry would block the repo's purpose.

# Paths the scan skips. Vendored blobs and caches are not ours to sanitize,
# and scanning them produces noise that trains people to ignore the gate.
exclude:
  - vendor/**
  - node_modules/**
  - .venv/**
  - "charts/**/charts/**"   # pulled subchart archives (helm dependency build)
  - "*.tgz"
  - "*.onnx"
  - "*.pt"
  - "*.safetensors"
  - Chart.lock
  - uv.lock
